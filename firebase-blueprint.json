{
  "entities": {
    "TeacherProfile": {
      "title": "Teacher Profile",
      "description": "Profile information for the teacher and class settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "teacherName": { "type": "string" },
        "schoolName": { "type": "string" },
        "className": { "type": "string" },
        "academicYear": { "type": "string" },
        "semester": { "type": "string" },
        "schoolLogo": { "type": "string" }
      },
      "required": ["userId", "teacherName", "schoolName", "className"]
    },
    "Students": {
      "title": "Students",
      "description": "Student roster in the class",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "nis": { "type": "string" },
        "name": { "type": "string" },
        "gender": { "type": "string" },
        "birthDate": { "type": "string" },
        "parentName": { "type": "string" },
        "parentWhatsapp": { "type": "string" },
        "address": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["teacherId", "name", "isActive"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily student attendance records",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "date": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["teacherId", "date", "studentId", "status"]
    },
    "Notes": {
      "title": "Notes",
      "description": "Teacher daily journal and class developments",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["teacherId", "date", "title", "content"]
    },
    "Announcements": {
      "title": "Announcements",
      "description": "Class announcements and notices",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["teacherId", "title", "content", "date", "status"]
    },
    "Savings": {
      "title": "Savings",
      "description": "Student class savings transactions",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal"] },
        "note": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["teacherId", "studentId", "amount", "type", "date"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback sent to system support",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "type": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "type", "message"]
    },
    "ImplementationRequests": {
      "title": "Implementation Requests",
      "description": "School onboarding implementation requests",
      "type": "object",
      "properties": {
        "requestId": { "type": "string" },
        "schoolName": { "type": "string" },
        "contactName": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "city": { "type": "string" },
        "educationLevel": { "type": "string" },
        "teacherCount": { "type": "number" },
        "studentCount": { "type": "number" },
        "notes": { "type": "string" },
        "plan": { "type": "string", "enum": ["SekolahHub Class Basic", "SekolahHub Class Pro", "Basic Free", "Pro"] },
        "authProvisioning": { "type": "string" },
        "status": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["schoolName", "contactName", "email", "whatsapp", "city", "educationLevel", "teacherCount", "studentCount", "plan", "status", "submittedAt"]
    }
  },
  "firestore": {
    "/TeacherProfile/{docId}": {
      "schema": { "$ref": "#/entities/TeacherProfile" },
      "description": "Teacher profiles"
    },
    "/Students/{docId}": {
      "schema": { "$ref": "#/entities/Students" },
      "description": "Student list"
    },
    "/Attendance/{docId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Attendance records"
    },
    "/Notes/{docId}": {
      "schema": { "$ref": "#/entities/Notes" },
      "description": "Teacher notes"
    },
    "/Announcements/{docId}": {
      "schema": { "$ref": "#/entities/Announcements" },
      "description": "Class announcements"
    },
    "/Savings/{docId}": {
      "schema": { "$ref": "#/entities/Savings" },
      "description": "Savings transactions"
    },
    "/Feedback/{docId}": {
      "schema": { "$ref": "#/entities/Feedback" },
      "description": "User feedback messages"
    },
    "/ImplementationRequests/{docId}": {
      "schema": { "$ref": "#/entities/ImplementationRequests" },
      "description": "Implementation requests"
    }
  }
}
